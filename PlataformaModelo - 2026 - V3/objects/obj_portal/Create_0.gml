// DIDÁTICO: O portal gerencia a transição de salas (fases) de forma dinâmica.
// Inicializamos variáveis padrão que devem ser sobrescritas no Editor de Salas 
// (Creation Code de cada instância do portal) para apontar para a sala e spawn corretos.

targetRoom = noone;  // Asset da Room para a qual ir (ex: rm_1, rm_2)
targetX = 0;         // Coordenada X de spawn na nova sala
targetY = 0;         // Coordenada Y de spawn na nova sala
